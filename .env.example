# Model providers
# ---------------------------------------------------------------------------
# Set at least one provider's API key. Every provider with a key set joins the
# fallback chain: if the first one errors, the next one runs. Order comes from
# LLM_PROVIDER_ORDER below, else every provider with a key, Anthropic first.

# Anthropic (the default provider).
ANTHROPIC_API_KEY=
# Optional: override Anthropic's model for both roles.
ANTHROPIC_MODEL=

# OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=

# Mistral.
MISTRAL_API_KEY=
MISTRAL_MODEL=

# OpenRouter, or any other OpenAI-shaped endpoint (self-hosted, a proxy, etc.)
# via OPENROUTER_BASE_URL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=

# Optional: fallback order, comma separated, e.g. "anthropic,openai,mistral".
# Leave unset to use every provider that has a key, Anthropic first.
LLM_PROVIDER_ORDER=

# Optional: pin the extraction call to one provider and model, e.g.
# "openai:gpt-5". A bare value with no colon overrides the model on whichever
# provider ends up handling the call.
EXTRACTION_MODEL_ID=

# Optional: same idea as EXTRACTION_MODEL_ID, for the guardrail (safety check)
# call only.
GUARDRAIL_MODEL_ID=

# Optional: run the guardrail on a different provider than the extraction, so
# abusive input reaching that key cannot affect your main provider account.
# A bare provider name, no colon, no fallback for this one call. Recommended
# if you want the safety check isolated from your primary provider.
GUARDRAIL_PROVIDER=

# Optional, local testing only: set to "claude-cli" to run both AI calls
# through the installed Claude Code CLI (billed to its own login) instead of a
# provider API key. This is refused unless ALLOW_LOCAL_ONLY_BACKENDS is set to
# true in src/lib/extraction/localBackendFlag.ts, and always refused in
# production. Leave unset in every real deployment. See README.md.
LLM_BACKEND=

# Rate limiting (Upstash Redis, over its HTTP API)
# ---------------------------------------------------------------------------
# Protects the paid /api/extract-fields route from cost abuse. Holds only
# short-lived integer counters keyed by a salted hash of the caller's IP, never
# document text or user data. Without these two set, the app falls back to an
# in-memory limiter that only works within one warm server instance: fine for
# local dev, not for a real deployment with more than one instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: salt mixed into the caller's IP before it becomes a store key. Set
# a real secret in production; the built-in default is fine for local dev.
RATE_LIMIT_SALT=

# Optional: how many blocked or refused requests from one caller within an
# hour before every further request from them is refused too. Defaults to 5.
ABUSE_BLOCK_THRESHOLD=
