{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-document-reviewer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Secrets (provider API keys, UPSTASH_*, RATE_LIMIT_SALT) are set with
  // `wrangler secret put <NAME>`, not here. See README.md.
}
